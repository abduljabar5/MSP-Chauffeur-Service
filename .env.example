# Copy to .env and fill in (or copy the .env from the TTCS.3 project — same Netlify account).

# Google Maps API (public browser key, same one used on mspairportchauffeur.com)
GOOGLE_MAPS_API_KEY=AIzaSyBbnDwOVUFnHx7N4uQVsjUMAO_4acoHyqQ

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Set in Netlify UI after creating the webhook endpoint:
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender address — must be on a domain verified in Resend. Use onboarding@resend.dev for testing only.
RESEND_FROM_EMAIL=
# Where new-booking / cancellation alert emails go
OWNER_EMAIL=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number texts are sent FROM (E.164, e.g. +16125551234)
TWILIO_FROM_NUMBER=
# Where new-booking / cancellation alerts are texted (defaults to the dispatch line)
OWNER_PHONE=+16126665004
# Optional — needed for scheduled SMS reminders:
TWILIO_MESSAGING_SERVICE_SID=

# Admin dashboard / cancellation auth token (any long random string)
CANCEL_ADMIN_TOKEN=

# Optional backup alert address if owner email AND SMS both fail
OWNER_BACKUP_EMAIL=

# Post-ride review request (email + text). Leave empty to disable until the Google Business Profile exists.
GOOGLE_REVIEW_LINK=
